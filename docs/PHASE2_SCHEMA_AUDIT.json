      "indexes": [
        "CREATE UNIQUE INDEX clients_pkey ON public.clients USING btree (id)",
        "CREATE INDEX clients_name_idx ON public.clients USING btree (lower(name))",
        "CREATE INDEX clients_active_idx ON public.clients USING btree (is_active, name)"
      ],
      "triggers": [
        "CREATE TRIGGER catalog_audit AFTER INSERT OR UPDATE ON public.clients FOR EACH ROW EXECUTE FUNCTION private.audit_catalog()",
        "CREATE TRIGGER catalog_stamp BEFORE UPDATE ON public.clients FOR EACH ROW EXECUTE FUNCTION private.catalog_stamp()"
      ],
      "constraints": [
        {
          "name": "clients_address_check",
          "definition": "CHECK ((length(address) <= 1000))"
        },
        {
          "name": "clients_email_check",
          "definition": "CHECK (((email ~ '^[^ @]+@[^ @]+\\.[^ @]+$'::text) AND (length(email) <= 254)))"
        },
        {
          "name": "clients_email_no_whitespace",
          "definition": "CHECK ((email !~ '[[:space:]]'::text))"
        },
        {
          "name": "clients_location_check",
          "definition": "CHECK ((length(location) <= 300))"
        },
        {
          "name": "clients_name_check",
          "definition": "CHECK (((length(TRIM(BOTH FROM name)) >= 1) AND (length(TRIM(BOTH FROM name)) <= 120)))"
        },
        {
          "name": "clients_notes_check",
          "definition": "CHECK ((length(notes) <= 3000))"
        },
        {
          "name": "clients_phone_check",
          "definition": "CHECK ((phone ~ '^\\+?[0-9 ()-]{8,25}$'::text))"
        },
        {
          "name": "clients_pkey",
          "definition": "PRIMARY KEY (id)"
        },
        {
          "name": "clients_phone_has_digit",
          "definition": "CHECK ((phone ~ '[0-9]'::text))"
        }
      ]
    },
