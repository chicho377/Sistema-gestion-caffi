# URL y clave PUBLICABLE del proyecto Supabase (no son claves administrativas).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Solo servidor. Nunca prefijar con NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Solo servidor: secreto aleatorio de al menos 32 caracteres para validar el flujo
